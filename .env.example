# No secrets in NEXT_PUBLIC_ variables. Copy to .env.local.
# Current model confirmed against https://api-docs.deepseek.com/ on 2026-10-17.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# For production, set this to the exact public HTTPS origin, with no trailing slash.
# For local development leave empty (do not set APP_ORIGIN to an empty string).
# APP_ORIGIN=https://your-domain.example
AI_FREE_DAILY_LIMIT=5
AI_PREMIUM_DAILY_LIMIT=100
# Fixed server quota day; learning streaks use the user's local date.
AI_QUOTA_TIMEZONE=Asia/Shanghai
# Development only. Production always rejects demo subscription changes.
ENABLE_DEMO_SUBSCRIPTIONS=true
# Optional Supabase Auth + Postgres. Apply database/schema.sql before enabling.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Leave blank to display 尚未定价; setting a label does not enable payments.
PREMIUM_PRICE_LABEL=
# Development server state is stored in .runtime/server.json (ignored by git).
# Production always requires the Supabase database instead of a local filesystem.
