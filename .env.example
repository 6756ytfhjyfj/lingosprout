# No secrets in NEXT_PUBLIC_ variables. Copy to .env.local.
# Current model confirmed against https://api-docs.deepseek.com/ on 2026-10-17.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# For production, set this to the exact public HTTPS origin, with no trailing slash.
# For local development leave empty (do not set APP_ORIGIN to an empty string).
# APP_ORIGIN=https://your-domain.example
AI_FREE_DAILY_LIMIT=5
AI_PREMIUM_DAILY_LIMIT=100
# Fixed server quota day; learning streaks use the user's local date.
AI_QUOTA_TIMEZONE=Asia/Shanghai
# Premium is approved by administrators. Self activation is always disabled.
# Supabase Auth + Postgres. Apply database/schema.sql, then database/accounts.sql.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Alternative: Edge backend's independent server credential. Use either this
# gateway or a service key. Deploy supabase/functions/lingosprout-backend first.
BACKEND_GATEWAY_KEY=
# 32 random bytes in hex; required for admin API-key configuration. Never rotate
# without first replacing stored encrypted API keys in the administrator console.
CONFIG_ENCRYPTION_KEY=
# No payment service: Premium page displays introduction and application only.
# Development server state is stored in .runtime/server.json (ignored by git).
# Production always requires the Supabase database instead of a local filesystem.
